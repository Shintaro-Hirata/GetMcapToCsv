# scripts/gcp_fetch.sh 用の設定。gcp.env にコピーして自分の環境に合わせて編集する。
#   cp scripts/gcp.env.example scripts/gcp.env
# gcp.env は .gitignore 済み。

# 対象 VM (gcloud compute instances list で確認)
GCP_PROJECT="your-project-id"
GCP_ZONE="asia-northeast1-a"     # バケット t2-ft-original-data と同一リージョンの VM を選ぶこと
GCP_VM="your-vm-name"

# VM 上でツールを置く/実行するディレクトリ (無ければ自動作成)
REMOTE_DIR="~/GetMcapToCsv"

# VM 上の Python / 既存 venv を使う場合は指定 (例: zero-plotter の venv を流用)
# VENV_DIR="/opt/zero-plotter/.venv"

# /t2/* デコード用の mcap-ros2idl-support を手元から VM へ自動転送する場合、
# 手元 PC 上のそのフォルダのパスを指定。取得方法:
#   git clone -b yatagarasu/main https://github.com/t2-auto/zero-plotter.git
# clone した中の mcap-ros2idl-support フォルダを指す。VM 側 GitHub 認証は不要になる。
# ROS2IDL_LOCAL_PATH="C:/Users/ShintaroHirata/Desktop/Dev/zero-plotter/mcap-ros2idl-support"

# 最小公開 VM (gcp_create_vm.sh の PRIVATE=1、既定) では IAP トンネル SSH が必須。
# その VM を使うときは次を有効化しておく (gcp_fetch.sh の ssh/scp 両方に効く)。
# GCLOUD_SSH_FLAGS="--tunnel-through-iap"

# VM の公開範囲を標準 (外部IPあり) にしたい場合のみ 0 にする。既定は 1 (最小公開)。
# PRIVATE=0
