# GCP 内実行スクリプト共通の設定。gcp.env にコピーして自分の環境に合わせて編集する。
#   PowerShell: Copy-Item scripts\gcp.env.example scripts\gcp.env
#   bash:       cp scripts/gcp.env.example scripts/gcp.env
# .ps1 (PowerShell) も .sh (bash) もこの同じ gcp.env を読む。gcp.env は .gitignore 済み。

# 対象 VM (gcloud compute instances list で確認)
GCP_PROJECT="your-project-id"
# GCP_ZONE はバケット t2-ft-original-data と同一リージョンの VM を選ぶこと (東京は asia-northeast1)
GCP_ZONE="asia-northeast1-a"
GCP_VM="your-vm-name"

# VM 上でツールを置く/実行するディレクトリ (VM のホーム直下からの相対パス。無ければ自動作成)
# ※ 先頭に ~/ を付けないこと (Windows の pscp が ~ を展開できず失敗するため)
REMOTE_DIR="GetMcapToCsv"

# VM 上の Python / 既存 venv を使う場合は指定 (例: zero-plotter の venv を流用)
# VENV_DIR="/opt/zero-plotter/.venv"

# /t2/* デコード用の mcap-ros2idl-support を手元から VM へ自動転送する場合、
# 手元 PC 上のそのフォルダのパスを指定。取得方法:
#   git clone -b yatagarasu/main https://github.com/t2-auto/zero-plotter.git
# clone した中の mcap-ros2idl-support フォルダを指す。VM 側 GitHub 認証は不要になる。
# ROS2IDL_LOCAL_PATH="C:/Users/ShintaroHirata/Desktop/Dev/zero-plotter/mcap-ros2idl-support"

# VM のネットワークを最小公開にしたい場合のみ 1 にする (既定 0 = 外部IP付きの標準VM)。
# PRIVATE=1 は外部IPなし + IAP SSH。その場合は下の GCLOUD_SSH_FLAGS も有効化すること。
# PRIVATE=1

# PRIVATE=1 の VM では IAP トンネル SSH が必須 (gcp_fetch.sh の ssh/scp 両方に効く)。
# PRIVATE=0 (既定) では不要。
# GCLOUD_SSH_FLAGS="--tunnel-through-iap"
